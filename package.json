{
  "name": "dsh-scheduled-send",
  "version": "0.2.0",
  "type": "module",
  "description": "在 DSH 输入框的发送按钮旁加一个箭头：选好日期时间，由宿主到点把这条消息投递进会话——关掉页面、切走会话都照发。",
  "keywords": [
    "dsh-plugin",
    "dsh",
    "deepseek-harness",
    "scheduled-send",
    "schedule",
    "composer",
    "feishu"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wangjiaxi/dsh-scheduled-send.git"
  },
  "homepage": "https://github.com/wangjiaxi/dsh-scheduled-send#readme",
  "bugs": {
    "url": "https://github.com/wangjiaxi/dsh-scheduled-send/issues"
  },
  "engines": {
    "node": ">=20"
  },
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "scripts",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "validate": "node scripts/validate.mjs"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-client-locale": "^0.2.0-rc.2",
    "@deepseek-ai/dsh-client-ui-conversation": "^0.2.0-rc.2",
    "@deepseek-ai/dsh-client-ui-slots": "^0.2.0-rc.2"
  },
  "dsh": {
    "manifestVersion": 1,
    "engines": {
      "dsh": ">=0.2.0-rc.1 <0.3.0"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  },
  "publishConfig": {
    "access": "public"
  }
}
